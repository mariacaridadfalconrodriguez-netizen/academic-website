---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { withBase } from '../lib/url';
import profile from '../data/profile.yaml';
import about from '../data/about.yaml';
import research from '../data/research.yaml';
import publications from '../data/publications.yaml';
import portrait from '../assets/profile.png';

const featuredAreas = research.areas.slice(0, 3);
const selected = publications.articles.slice(0, 3);
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-grid">
    <div class="pointer-events-none absolute -left-32 top-10 h-96 w-96 rounded-full bg-accent-300/25 blur-3xl dark:bg-accent-700/15"></div>
    <div class="pointer-events-none absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-gold-400/15 blur-3xl"></div>

    <div class="container-page relative grid items-center gap-12 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
      <div class="reveal">
        <p class="eyebrow">{profile.title}</p>
        <h1 class="mt-4 font-serif text-5xl font-semibold leading-[1.05] text-ink-900 dark:text-white sm:text-6xl">
          {profile.honorific} {profile.name}
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">
          {profile.heroIntro}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/research')} class="btn btn-primary">
            Explore research <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href={withBase('/cv')} class="btn btn-ghost">
            <Icon name="download" class="h-4 w-4" /> Curriculum Vitae
          </a>
          <a href={withBase('/contact')} class="btn btn-ghost">Get in touch</a>
        </div>

        <div class="mt-10">
          <SocialLinks variant="compact" />
        </div>
      </div>

      <div class="reveal relative mx-auto w-full max-w-sm">
        <div class="absolute inset-0 -rotate-3 rounded-[2rem] bg-gradient-to-br from-accent-200 to-accent-400/50 dark:from-accent-700/40 dark:to-accent-900/40"></div>
        <div class="relative overflow-hidden rounded-[2rem] border border-white/60 shadow-2xl shadow-ink-900/20 dark:border-ink-700">
          <Image
            src={portrait}
            alt={`Portrait of ${profile.honorific} ${profile.name}`}
            widths={[360, 540, 720]}
            sizes="(max-width: 640px) 80vw, 24rem"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-5 -left-5 rounded-2xl border border-ink-200/70 bg-white/90 px-5 py-3 shadow-lg backdrop-blur dark:border-ink-700 dark:bg-ink-900/90">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-500 dark:text-ink-400">Based in</p>
          <p class="font-serif text-base font-semibold text-ink-900 dark:text-white">{profile.location}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key achievements -->
  <section class="container-page py-16">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {about.facts.map((fact) => (
        <div class="reveal card px-5 py-6 text-center">
          <p class="font-serif text-4xl font-semibold text-accent-700 dark:text-accent-300">{fact.value}</p>
          <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">{fact.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Research summary -->
  <section class="container-page py-12">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <p class="eyebrow">Research summary</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white sm:text-4xl">
          Tourism as a driver of sustainable development
        </h2>
      </div>
      <div class="reveal">
        <p class="text-lg leading-relaxed text-ink-600 dark:text-ink-300">{about.bioShort}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {about.focus.map((f) => <span class="chip">{f}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured research areas -->
  <section class="container-page py-16">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div class="reveal">
        <p class="eyebrow">Focus areas</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white sm:text-4xl">Research highlights</h2>
      </div>
      <a href={withBase('/research')} class="reveal hidden items-center gap-2 text-sm font-semibold text-accent-700 hover:text-accent-900 dark:text-accent-300 sm:inline-flex">
        All research <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {featuredAreas.map((area) => (
        <article class="reveal card card-hover p-7">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300">
            <Icon name={area.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 font-serif text-xl font-semibold text-ink-900 dark:text-white">{area.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{area.description}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Selected publications -->
  <section class="container-page py-16">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div class="reveal">
        <p class="eyebrow">Selected work</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white sm:text-4xl">Recent publications</h2>
      </div>
      <a href={withBase('/publications')} class="reveal hidden items-center gap-2 text-sm font-semibold text-accent-700 hover:text-accent-900 dark:text-accent-300 sm:inline-flex">
        All publications <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <div class="space-y-4">
      {selected.map((pub) => (
        <article class="reveal card card-hover flex flex-col gap-2 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="sm:pr-6">
            <h3 class="font-serif text-lg font-semibold leading-snug text-ink-900 dark:text-white">{pub.title}</h3>
            <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">{pub.venue}</p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <span class="chip">{pub.year}</span>
            {pub.url && (
              <a href={pub.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-accent-700 dark:text-accent-300">
                View <Icon name="external" class="h-4 w-4" />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA band -->
  <section class="container-page py-16">
    <div class="reveal relative overflow-hidden rounded-3xl bg-accent-800 px-8 py-14 text-center dark:bg-accent-900">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
      <div class="pointer-events-none absolute -bottom-16 -left-16 h-64 w-64 rounded-full bg-gold-400/15 blur-2xl"></div>
      <h2 class="relative font-serif text-3xl font-semibold text-white sm:text-4xl">Open to collaboration & supervision</h2>
      <p class="relative mx-auto mt-4 max-w-2xl text-accent-100">
        I welcome research partnerships, graduate supervision and speaking invitations in tourism management, sustainability and regional development.
      </p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase('/contact')} class="btn bg-white text-accent-800 hover:bg-accent-50">Start a conversation</a>
        <a href={withBase('/publications')} class="btn border border-white/40 text-white hover:bg-white/10">Read publications</a>
      </div>
    </div>
  </section>
</BaseLayout>
