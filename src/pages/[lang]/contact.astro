---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getContent } from '../../i18n/content';
import { useTranslations, type Lang } from '../../i18n/ui';
import { getLangStaticPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const contact = getContent(lang).contact;

const iconFor: Record<string, string> = {
  mail: 'mail',
  orcid: 'orcid',
  scholar: 'scholar',
  researchgate: 'researchgate',
  linkedin: 'linkedin',
};
---
<BaseLayout lang={lang} title={t.contact.title} description={contact.intro}>
  <PageHeader eyebrow={t.contact.eyebrow} title={t.contact.title} intro={contact.intro} />

  <section class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="reveal space-y-6">
        <div class="card p-6">
          <p class="eyebrow">{t.contact.direct}</p>
          <ul class="mt-4 space-y-4 text-sm">
            <li class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="mail" class="h-5 w-5" /></span>
              <a href={`mailto:${contact.email}`} class="break-all font-medium text-ink-800 hover:text-accent-700 dark:text-ink-100 dark:hover:text-accent-300">{contact.email}</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="phone" class="h-5 w-5" /></span>
              <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="font-medium text-ink-800 hover:text-accent-700 dark:text-ink-100 dark:hover:text-accent-300">{contact.phone}</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="pin" class="h-5 w-5" /></span>
              <span class="font-medium text-ink-800 dark:text-ink-100">{contact.location}</span>
            </li>
          </ul>
        </div>

        <div class="card p-6">
          <p class="eyebrow">{t.contact.profiles}</p>
          <div class="mt-4 space-y-3">
            {contact.channels.map((ch) => (
              <a
                href={ch.url}
                target={ch.url.startsWith('http') ? '_blank' : undefined}
                rel={ch.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center justify-between rounded-xl border border-ink-200/70 px-4 py-3 transition hover:border-accent-400 dark:border-ink-800"
              >
                <span class="flex items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink-100 text-ink-600 transition group-hover:bg-accent-700 group-hover:text-white dark:bg-ink-800 dark:text-ink-300"><Icon name={iconFor[ch.icon] ?? 'external'} class="h-4 w-4" /></span>
                  <span>
                    <span class="block text-sm font-semibold text-ink-900 dark:text-white">{ch.label}</span>
                    <span class="block text-xs text-ink-500 dark:text-ink-400">{ch.value}</span>
                  </span>
                </span>
                <Icon name="arrow" class="h-4 w-4 text-ink-400 transition group-hover:text-accent-600" />
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="reveal">
        <form id="contact-form" class="card p-7">
          <p class="eyebrow">{t.contact.sendMessage}</p>
          <h2 class="mt-2 font-serif text-xl font-semibold text-ink-900 dark:text-white">{t.contact.formTitle}</h2>
          <div class="mt-6 space-y-4">
            <div>
              <label for="cf-name" class="block text-sm font-medium text-ink-700 dark:text-ink-200">{t.contact.name}</label>
              <input id="cf-name" name="name" type="text" required class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white/80 px-4 py-2.5 text-sm text-ink-800 focus:border-accent-400 dark:border-ink-700 dark:bg-ink-900/60 dark:text-ink-100" />
            </div>
            <div>
              <label for="cf-email" class="block text-sm font-medium text-ink-700 dark:text-ink-200">{t.contact.yourEmail}</label>
              <input id="cf-email" name="email" type="email" required class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white/80 px-4 py-2.5 text-sm text-ink-800 focus:border-accent-400 dark:border-ink-700 dark:bg-ink-900/60 dark:text-ink-100" />
            </div>
            <div>
              <label for="cf-subject" class="block text-sm font-medium text-ink-700 dark:text-ink-200">{t.contact.subject}</label>
              <input id="cf-subject" name="subject" type="text" class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white/80 px-4 py-2.5 text-sm text-ink-800 focus:border-accent-400 dark:border-ink-700 dark:bg-ink-900/60 dark:text-ink-100" />
            </div>
            <div>
              <label for="cf-message" class="block text-sm font-medium text-ink-700 dark:text-ink-200">{t.contact.message}</label>
              <textarea id="cf-message" name="message" rows="5" required class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white/80 px-4 py-2.5 text-sm text-ink-800 focus:border-accent-400 dark:border-ink-700 dark:bg-ink-900/60 dark:text-ink-100"></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">
            <Icon name="mail" class="h-4 w-4" /> {t.contact.openInEmail}
          </button>
          <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">{t.contact.formHint}</p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ to: contact.email, subjectDefault: t.contact.defaultSubject }}>
    (() => {
      const form = document.getElementById('contact-form');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = data.get('name') || '';
        const email = data.get('email') || '';
        const subject = data.get('subject') || subjectDefault;
        const message = data.get('message') || '';
        const body = `${message}\n\n— ${name} (${email})`;
        window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    })();
  </script>
</BaseLayout>
