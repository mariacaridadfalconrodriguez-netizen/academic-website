---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getContent } from '../../i18n/content';
import { useTranslations, type Lang } from '../../i18n/ui';
import { getLangStaticPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const news = getContent(lang).news;

const locale = lang === 'es' ? 'es-ES' : 'en-GB';
function formatDate(value: string) {
  const d = new Date(value);
  if (isNaN(d.getTime())) return value;
  return d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
}

const items = [...(news.items ?? [])].sort((a, b) =>
  String(b.date ?? '').localeCompare(String(a.date ?? ''))
);
---
<BaseLayout lang={lang} title={t.news.title} description={news.intro}>
  <PageHeader eyebrow={t.news.eyebrow} title={t.news.title} intro={news.intro} />

  <section class="container-page py-16">
    {items.length === 0 && (
      <div class="reveal mx-auto max-w-3xl card border-dashed p-10 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="news" class="h-7 w-7" /></span>
        <p class="mt-6 text-ink-600 dark:text-ink-300">{t.news.empty}</p>
      </div>
    )}

    <div class="mx-auto max-w-3xl space-y-10">
      {items.map((item) => (
          <article class="reveal card card-hover overflow-hidden p-7">
            <div class="flex items-center gap-2 text-sm text-ink-500 dark:text-ink-400">
              <Icon name="calendar" class="h-4 w-4 text-accent-500" />
              <time datetime={item.date}>{formatDate(item.date)}</time>
            </div>

            <h2 class="mt-3 font-serif text-2xl font-semibold text-ink-900 dark:text-white">{item.title}</h2>

            {item.tags && item.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {item.tags.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            )}

            <p class="mt-4 leading-relaxed text-ink-600 dark:text-ink-300">{item.summary}</p>

            {item.video && (
              <div class="mt-6 aspect-video overflow-hidden rounded-xl border border-ink-200/70 bg-ink-950/5 dark:border-ink-800">
                <iframe
                  class="h-full w-full"
                  src={`https://www.youtube.com/embed/${item.video}`}
                  title={item.title}
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
            )}

            {item.link && (
              <div class="mt-6">
                <a href={item.link} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                  {item.linkLabel || t.news.readMore} <Icon name="external" class="h-4 w-4" />
                </a>
              </div>
            )}
          </article>
      ))}
    </div>
  </section>
</BaseLayout>
