---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getContent } from '../../i18n/content';
import { useTranslations, type Lang } from '../../i18n/ui';
import { getLangStaticPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { teaching, supervision } = getContent(lang);

const graduate = teaching.courses.filter((c) => c.level === 'Graduate');
const undergraduate = teaching.courses.filter((c) => c.level === 'Undergraduate');
const theses = [...supervision.theses].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const supFilters = [
  { key: 'All', label: t.teaching.filterAll },
  { key: "Master's", label: t.teaching.filterMasters },
  { key: 'Doctoral', label: t.teaching.filterDoctoral },
];
const badge = t.teaching.badge as Record<string, string>;
---
<BaseLayout lang={lang} title={t.teaching.title} description={teaching.intro}>
  <PageHeader eyebrow={t.teaching.eyebrow} title={t.teaching.title} intro={teaching.intro} />

  <section class="container-page py-16">
    <p class="eyebrow reveal">{t.teaching.approach}</p>
    <h2 class="reveal mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white">{t.teaching.philosophy}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {teaching.mentoring.map((m) => (
        <article class="reveal card p-7">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="spark" class="h-6 w-6" /></span>
          <h3 class="mt-5 font-serif text-lg font-semibold text-ink-900 dark:text-white">{m.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{m.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page py-8">
    <p class="eyebrow reveal">{t.teaching.courses}</p>
    <h2 class="reveal mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white">{t.teaching.coursesTaught}</h2>

    <div class="mt-10 space-y-12">
      <div>
        <h3 class="reveal flex items-center gap-2 font-serif text-xl font-semibold text-ink-900 dark:text-white"><Icon name="cap" class="h-5 w-5 text-accent-600 dark:text-accent-400" /> {t.teaching.graduate}</h3>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {graduate.map((course) => (
            <article class="reveal card card-hover p-6">
              <div class="flex items-start justify-between gap-3">
                <h4 class="font-serif text-lg font-semibold text-ink-900 dark:text-white">{course.name}</h4>
                <span class="chip shrink-0">{course.years}</span>
              </div>
              <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">{course.program}</p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <h3 class="reveal flex items-center gap-2 font-serif text-xl font-semibold text-ink-900 dark:text-white"><Icon name="book" class="h-5 w-5 text-accent-600 dark:text-accent-400" /> {t.teaching.undergraduate}</h3>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {undergraduate.map((course) => (
            <article class="reveal card card-hover p-6">
              <div class="flex items-start justify-between gap-3">
                <h4 class="font-serif text-lg font-semibold text-ink-900 dark:text-white">{course.name}</h4>
                <span class="chip shrink-0">{course.years}</span>
              </div>
              <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">{course.program}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{t.teaching.supervision}</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white">{t.teaching.thesisSupervision}</h2>
      </div>
      <div class="flex gap-3 text-sm">
        <span class="card px-4 py-2"><strong class="font-serif text-accent-700 dark:text-accent-300">{supervision.summary.total}</strong> {t.teaching.total}</span>
        <span class="card px-4 py-2"><strong class="font-serif text-accent-700 dark:text-accent-300">{supervision.summary.doctoral}</strong> {t.teaching.doctoral}</span>
        <span class="card px-4 py-2"><strong class="font-serif text-accent-700 dark:text-accent-300">{supervision.summary.masters}</strong> {t.teaching.masters}</span>
      </div>
    </div>

    <div class="reveal mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="relative w-full sm:max-w-sm">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input id="thesis-search" type="search" placeholder={t.teaching.searchPlaceholder} class="w-full rounded-full border border-ink-200 bg-white/80 py-3 pl-11 pr-4 text-sm text-ink-800 placeholder:text-ink-400 focus:border-accent-400 dark:border-ink-700 dark:bg-ink-900/60 dark:text-ink-100" aria-label={t.teaching.searchPlaceholder} />
      </div>
      <div class="flex flex-wrap gap-2" role="group">
        {supFilters.map((f) => (
          <button type="button" data-stype={f.key} data-active={f.key === 'All' ? 'true' : 'false'} class="thesis-filter rounded-full border border-ink-200 px-4 py-2 text-xs font-semibold text-ink-600 transition hover:border-accent-400 data-[active=true]:border-accent-600 data-[active=true]:bg-accent-700 data-[active=true]:text-white dark:border-ink-700 dark:text-ink-300 dark:data-[active=true]:bg-accent-500 dark:data-[active=true]:text-ink-950">{f.label}</button>
        ))}
      </div>
    </div>

    <p id="thesis-empty" class="mt-8 hidden text-center text-sm text-ink-500 dark:text-ink-400">{t.common.noResults}</p>

    <ul id="thesis-list" class="mt-8 space-y-3">
      {theses.map((th) => (
        <li class="thesis-item reveal card p-5" data-stype={th.type} data-search={`${th.student} ${th.title}`.toLowerCase()}>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div class="sm:pr-6">
              <div class="flex flex-wrap items-center gap-2">
                <span class:list={['rounded-full px-2.5 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wide', th.type === 'Doctoral' ? 'bg-gold-400/15 text-gold-600 dark:text-gold-400' : 'bg-accent-100 text-accent-800 dark:bg-accent-500/15 dark:text-accent-200']}>{badge[th.type]}</span>
                <p class="font-semibold text-ink-900 dark:text-white">{th.student}</p>
              </div>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{th.title}</p>
            </div>
            {th.year && <span class="chip shrink-0 self-start">{th.year}</span>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <script is:inline>
    (() => {
      const search = document.getElementById('thesis-search');
      const filters = Array.from(document.querySelectorAll('.thesis-filter'));
      const items = Array.from(document.querySelectorAll('.thesis-item'));
      const empty = document.getElementById('thesis-empty');
      let activeType = 'All';

      function apply() {
        const q = (search?.value || '').trim().toLowerCase();
        let visible = 0;
        items.forEach((item) => {
          const matchesType = activeType === 'All' || item.getAttribute('data-stype') === activeType;
          const matchesText = !q || (item.getAttribute('data-search') || '').includes(q);
          const show = matchesType && matchesText;
          item.classList.toggle('hidden', !show);
          if (show) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      }

      search?.addEventListener('input', apply);
      filters.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeType = btn.getAttribute('data-stype') || 'All';
          filters.forEach((b) => b.setAttribute('data-active', String(b === btn)));
          apply();
        });
      });
    })();
  </script>
</BaseLayout>
