---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import CvDocument from '../../components/CvDocument.astro';
import { withBase } from '../../lib/url';
import { getContent } from '../../i18n/content';
import { useTranslations, type Lang } from '../../i18n/ui';
import { getLangStaticPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { about, education, positions, profile } = getContent(lang);
const cvAvailable = profile.cv?.available === true;
const cvFile = withBase(profile.cv?.file ?? '/');
---
<BaseLayout lang={lang} title={t.cv.title} description={t.cv.intro}>
  <PageHeader eyebrow={t.cv.eyebrow} title={t.cv.title} intro={t.cv.intro} />

  {cvAvailable ? (
    <CvDocument about={about} education={education} positions={positions} cvFile={cvFile} t={t} />
  ) : (
    <section class="container-page py-20">
      <div class="reveal mx-auto max-w-2xl card border-dashed p-10 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="doc" class="h-7 w-7" /></span>
        <h2 class="mt-6 font-serif text-2xl font-semibold text-ink-900 dark:text-white">{t.cv.comingSoonTitle}</h2>
        <p class="mt-3 text-ink-600 dark:text-ink-300">{t.cv.comingSoonText}</p>
      </div>
    </section>
  )}
</BaseLayout>
