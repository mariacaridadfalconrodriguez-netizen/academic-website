---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import projects from '../data/projects.yaml';
---
<BaseLayout title="Projects" description={projects.intro}>
  <PageHeader eyebrow="Projects" title="Research projects" intro={projects.intro} />

  <!-- Projects -->
  <section class="container-page py-16">
    <p class="eyebrow reveal">Competitive funding</p>
    <h2 class="reveal mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white">Funded projects</h2>
    <div class="mt-10 space-y-6">
      {projects.projects.map((proj) => (
        <article class="reveal card card-hover p-7">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div class="lg:max-w-3xl">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-accent-700 px-3 py-1 text-xs font-semibold text-white dark:bg-accent-500 dark:text-ink-950">{proj.role}</span>
                <span class="chip">{proj.period}</span>
                {proj.program && <span class="chip">{proj.program}</span>}
              </div>
              <h3 class="mt-4 font-serif text-xl font-semibold leading-snug text-ink-900 dark:text-white">{proj.title}</h3>
              <p class="mt-1 text-sm italic text-ink-500 dark:text-ink-400">{proj.original}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{proj.description}</p>
            </div>
            <div class="flex items-center gap-3 lg:flex-col lg:items-end lg:text-right">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="flask" class="h-6 w-6" /></span>
              <p class="text-xs text-ink-500 dark:text-ink-400">{proj.institution}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Research stays -->
  <section class="container-page py-12">
    <p class="eyebrow reveal">International mobility</p>
    <h2 class="reveal mt-3 font-serif text-3xl font-semibold text-ink-900 dark:text-white">Research stays</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {projects.stays.map((stay) => (
        <article class="reveal card card-hover p-7">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><Icon name="globe" class="h-6 w-6" /></span>
            <div>
              <h3 class="font-serif text-lg font-semibold text-ink-900 dark:text-white">{stay.institution}</h3>
              <p class="text-sm text-ink-600 dark:text-ink-300">{stay.location}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {stay.period !== '—' && <span class="chip">{stay.period}</span>}
                <span class="chip">{stay.duration}</span>
                <span class="chip">{stay.capacity}</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
