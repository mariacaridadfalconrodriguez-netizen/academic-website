---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="Page not found">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-serif text-7xl font-semibold text-accent-700 dark:text-accent-300">404</p>
    <h1 class="mt-4 font-serif text-3xl font-semibold text-ink-900 dark:text-white">Page not found</h1>
    <p class="mt-3 max-w-md text-ink-600 dark:text-ink-300">The page you are looking for may have moved or no longer exists.</p>
    <a href={withBase('/')} class="btn btn-primary mt-8"><Icon name="arrow" class="h-4 w-4" /> Back to home</a>
  </section>
</BaseLayout>
