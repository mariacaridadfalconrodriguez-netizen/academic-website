---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import awards from '../data/awards.yaml';
---
<BaseLayout title="Awards" description={awards.intro}>
  <PageHeader eyebrow="Distinctions" title="Awards & milestones" intro={awards.intro} />

  <section class="container-page py-16">
    <ol class="relative mx-auto max-w-3xl border-l-2 border-ink-200 pl-8 dark:border-ink-800">
      {awards.items.map((item) => (
        <li class="reveal relative pb-12 last:pb-0">
          <span class="absolute -left-[2.6rem] flex h-10 w-10 items-center justify-center rounded-full border-2 border-accent-200 bg-ink-50 text-accent-700 ring-4 ring-ink-50 dark:border-accent-700 dark:bg-ink-950 dark:text-accent-300 dark:ring-ink-950">
            <Icon name="spark" class="h-5 w-5" />
          </span>
          <div class="card card-hover p-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-serif text-2xl font-semibold text-accent-700 dark:text-accent-300">{item.year}</span>
              {item.placeholder && <span class="chip">To be confirmed</span>}
            </div>
            <h3 class="mt-2 font-serif text-xl font-semibold text-ink-900 dark:text-white">{item.title}</h3>
            <p class="text-sm font-medium text-accent-600 dark:text-accent-400">{item.organization}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Distinctions placeholder -->
  <section class="container-page pb-16">
    <div class="reveal mx-auto max-w-3xl card border-dashed p-8">
      <p class="eyebrow">Further distinctions</p>
      <h2 class="mt-3 font-serif text-xl font-semibold text-ink-900 dark:text-white">Additional honours</h2>
      <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">
        This section is ready to showcase further honours, editorial roles and recognitions as they are confirmed.
      </p>
      <ul class="mt-5 space-y-2">
        {awards.distinctions.map((d) => (
          <li class="flex items-start gap-3 text-sm text-ink-500 dark:text-ink-400">
            <Icon name="arrow" class="mt-1 h-4 w-4 shrink-0 text-accent-400" /> {d}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
