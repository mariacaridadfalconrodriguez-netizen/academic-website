---
import profile from '../data/profile.yaml';
import Icon from './Icon.astro';

interface Props {
  variant?: 'badges' | 'compact';
  class?: string;
}
const { variant = 'compact', class: className = '' } = Astro.props;

const iconFor: Record<string, string> = {
  orcid: 'orcid',
  scholar: 'scholar',
  researchgate: 'researchgate',
  linkedin: 'linkedin',
  email: 'mail',
};
---
{variant === 'badges' ? (
  <div class:list={['flex flex-wrap gap-3', className]}>
    {profile.links.map((link) => (
      <a
        href={link.url}
        target={link.url.startsWith('http') ? '_blank' : undefined}
        rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="card card-hover group flex items-center gap-3 px-4 py-3"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-100 text-accent-700 transition group-hover:bg-accent-700 group-hover:text-white dark:bg-accent-500/15 dark:text-accent-300 dark:group-hover:bg-accent-500 dark:group-hover:text-ink-950">
          <Icon name={iconFor[link.id] ?? 'external'} class="h-5 w-5" />
        </span>
        <span class="text-left">
          <span class="block text-sm font-semibold text-ink-900 dark:text-white">{link.label}</span>
          <span class="block text-xs text-ink-500 dark:text-ink-400">{link.handle}</span>
        </span>
      </a>
    ))}
  </div>
) : (
  <div class:list={['flex flex-wrap items-center gap-2', className]}>
    {profile.links.map((link) => (
      <a
        href={link.url}
        target={link.url.startsWith('http') ? '_blank' : undefined}
        rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
        aria-label={link.label}
        title={link.label}
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-600 transition hover:-translate-y-0.5 hover:border-accent-400 hover:text-accent-600 dark:border-ink-700 dark:text-ink-300 dark:hover:border-accent-500 dark:hover:text-accent-300"
      >
        <Icon name={iconFor[link.id] ?? 'external'} class="h-5 w-5" />
      </a>
    ))}
  </div>
)}
