---
import { getContent } from '../i18n/content';
import { useTranslations, type Lang } from '../i18n/ui';
import { link } from '../i18n/utils';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const site = c.site;
const profile = c.profile;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const cvAvailable = c.profile.cv?.available === true;
const navItems = site.nav.filter((item: { href: string }) => item.href !== '/cv' || cvAvailable);
---
<footer class="mt-24 border-t border-ink-200/60 bg-white/50 dark:border-ink-800/70 dark:bg-ink-900/30">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-serif text-lg font-semibold text-ink-900 dark:text-white">{site.title}</p>
        <p class="mt-2 max-w-xs text-sm text-ink-500 dark:text-ink-400">{site.role}</p>
        <div class="mt-5">
          <SocialLinks lang={lang} variant="compact" />
        </div>
      </div>

      <div>
        <p class="eyebrow">{t.common.explore}</p>
        <ul class="mt-4 grid grid-cols-2 gap-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={link(lang, item.href)} class="text-ink-600 transition hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-300">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">{t.common.contact}</p>
        <ul class="mt-4 space-y-2 text-sm text-ink-600 dark:text-ink-300">
          <li><a href={`mailto:${profile.email}`} class="transition hover:text-accent-700 dark:hover:text-accent-300">{profile.email}</a></li>
          <li>{profile.location}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-ink-200/60 pt-6 text-xs text-ink-500 dark:border-ink-800/70 dark:text-ink-400 sm:flex-row">
      <p>&copy; {year} {profile.name}. {t.common.allRightsReserved}</p>
      <p>{t.common.builtWith}</p>
    </div>
  </div>
</footer>
