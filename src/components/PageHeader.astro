---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---
<section class="relative overflow-hidden border-b border-ink-200/60 bg-grid dark:border-ink-800/70">
  <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent-300/20 blur-3xl dark:bg-accent-600/10"></div>
  <div class="container-page relative py-16 sm:py-20">
    {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
    <h1 class="reveal mt-3 font-serif text-4xl font-semibold leading-tight text-ink-900 dark:text-white sm:text-5xl">{title}</h1>
    {intro && (
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">{intro}</p>
    )}
  </div>
</section>
